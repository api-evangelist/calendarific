        {
          "name": "List Holidays",
          "id": "347803e3-5a4e-4359-bbbe-3d266f94d3ee",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/holidays?api_key=<string>&country=<string>&year=<integer>&day=<integer>&month=<integer>&location=<string>&type=observance&language=<string>&uuid=<boolean>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "holidays"
              ],
              "query": [
                {
                  "description": "(Required) Calendarific API key issued via the developer console.",
                  "key": "api_key",
                  "value": "<string>"
                },
                {
                  "description": "(Required) ISO-3166 country code (e.g., US, GB, IN).",
                  "key": "country",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Year to retrieve holidays for. Historical data available through 2049.",
                  "key": "year",
                  "value": "<integer>"
                },
                {
                  "description": "Filter to a specific day of the month (1-31).",
                  "key": "day",
                  "value": "<integer>"
                },
                {
                  "description": "Filter to a specific month (1-12).",
                  "key": "month",
                  "value": "<integer>"
                },
                {
                  "description": "ISO-3166 state or region code (e.g., us-ca for California).",
                  "key": "location",
                  "value": "<string>"
                },
                {
                  "description": "Filter by holiday type (national, local, religious, observance).",
                  "key": "type",
                  "value": "observance"
                },
                {
                  "description": "Premium parameter. Two-letter ISO639 language code.",
                  "key": "language",
                  "value": "<string>"
                },
                {
                  "description": "Premium parameter. Include UUID values for each holiday.",
                  "key": "uuid",
                  "value": "<boolean>"
                }
              ]
            },
            "description": "Returns holidays for a given country and year. Supports filtering\nby month, day, location (sub-region), holiday type, and language.\n"
          },
