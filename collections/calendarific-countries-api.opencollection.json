{
  "opencollection": "1.0.0",
  "info": {
    "name": "Calendarific Holiday Countries API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://calendarific.com/api/v2/countries",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "Calendarific API key."
              }
            ]
          },
          "docs": "Returns the full list of countries supported by Calendarific,\nincluding ISO-3166 codes and the languages supported per country.\n"
        }
      ]
    }
  ],
  "bundled": true
}