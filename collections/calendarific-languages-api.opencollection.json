{
  "opencollection": "1.0.0",
  "info": {
    "name": "Calendarific Holiday Countries Languages API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Languages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Languages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://calendarific.com/api/v2/languages",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "Calendarific API key."
              }
            ]
          },
          "docs": "Returns the full list of languages supported by Calendarific\nwith their two-letter ISO639 codes.\n"
        }
      ]
    }
  ],
  "bundled": true
}